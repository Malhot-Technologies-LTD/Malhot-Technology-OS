# Copy to .env.local for development. Names only — never commit real values.
# Full reference: docs/engineering/environment-variables.md

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings → API). New key format: sb_publishable_... / sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Tooling only, never read by the app. Lets `npm run db:types` connect straight
# to Postgres instead of requiring `supabase login` (Settings → Database).
SUPABASE_DB_PASSWORD=

# GitHub App (Malhot organisation) — server only
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=          # base64 of the .pem
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_STATE_SECRET=             # openssl rand -base64 32

# Jobs
CRON_SECRET=                     # openssl rand -base64 32

# Website
INQUIRY_IP_SALT=                 # openssl rand -base64 32

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
